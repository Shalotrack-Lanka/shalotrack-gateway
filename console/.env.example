# Copy to .env for LOCAL development only. Never commit real values.
# In production these come from SSM Parameter Store (SecureString) as container env vars.

# Gateway Command API (VPC-internal, port 8001)
GATEWAY_URL=http://gateway.shalotrack.internal:8001
COMMAND_API_KEY=change-me

# Who may view the console. Production: cloudflare_access (default).
CONSOLE_AUTH=cloudflare_access
CF_ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
CF_ACCESS_AUD=<64-char AUD tag of the Access application>
# Second lock behind Access: at least one of these is REQUIRED.
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=shalotrack.com

REFRESH_SECONDS=10
CONSOLE_TZ=Asia/Colombo

# Local development against a fake/real gateway ONLY (refused unless bound to loopback):
# CONSOLE_AUTH=none
# CONSOLE_ALLOW_INSECURE_NO_AUTH=1
